PORT=5000
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_role_or_secret_key

ADMIN_USERNAME=ogi
ADMIN_PASSWORD=ogi_resto
JWT_SECRET=your_jwt_secret_key

# WhatsApp Cloud API (Meta)
# Callback Meta: https://YOUR_PUBLIC_BACKEND/api/webhooks/whatsapp
# Buat token acak sendiri dan gunakan nilai yang sama pada kolom Verifikasi token di Meta.
WHATSAPP_VERIFY_TOKEN=
# App Secret dari Pengaturan Aplikasi > Dasar, berbeda dari token akses WhatsApp.
WHATSAPP_APP_SECRET=
# Phone Number ID dari halaman penyiapan API WhatsApp, bukan nomor telepon atau WABA ID.
WHATSAPP_PHONE_NUMBER_ID=
# Token akses Meta untuk panggilan Graph API; biarkan kosong jika hanya menerima webhook.
WHATSAPP_ACCESS_TOKEN=

# Baileys local group bot (separate process)
# Run npm.cmd run bot:groups, then copy selected group IDs below.
WA_GROUP_BOT_ENABLED=false
WA_GROUP_BOT_ALLOWED_GROUPS=
WA_GROUP_BOT_SESSION_KEY=
